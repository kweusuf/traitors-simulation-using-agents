# Generic OpenAI-compatible provider key (`llm.api_key_env` when unset).
# The value lives in this gitignored file; copy .env.example to .env.
OPENAI_COMPAT_API_KEY=

# Optional endpoint override for the openai_compat provider.
# OPENAI_COMPAT_BASE_URL=https://your-endpoint.example/v1

# OpenCode Go subscription key -- https://opencode.ai/console
# Used by the `.opencode_go` configs, which also set the
# `x-opencode-session` header the route expects.
OPENCODE_GO_API_KEY=

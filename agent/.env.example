# Command Code Provider API key -- https://commandcode.ai/docs/provider
# Create one in Command Code Studio > API keys, then paste it here.
# This file is gitignored; copy it to .env and fill the value.
COMMAND_CODE_API_KEY=

# OpenCode Go subscription key -- https://opencode.ai/console
# Used by the `.opencode_go` configs. The route also needs the
# `x-opencode-session` header those configs set.
OPENCODE_GO_API_KEY=

# Optional: override the endpoint or model without editing the config.
# COMMAND_CODE_BASE_URL=https://api.commandcode.ai/provider/v1

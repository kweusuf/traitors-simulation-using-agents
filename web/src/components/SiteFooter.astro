---
import { manifest } from '../lib/data';
import { formatNumber } from '../lib/format';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[var(--border)] bg-black/20">
  <div class="page-shell grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl tracking-[-0.03em]">Round Table</p>
      <p class="mt-3 max-w-md text-sm leading-6 text-muted">
        A config-driven framework for multi-agent LLM social simulations. Every
        game on this site was generated by the open-source project; every transcript
        is model-generated fiction.
      </p>
      <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.16em] text-muted">
        Unofficial — not affiliated with the show or its contestants.
      </p>
    </div>
    <div>
      <p class="stat-label">Explore</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-parchment" href="/runs">All runs</a></li>
        <li><a class="hover:text-parchment" href="/runs/us-s03">US S03 deep dive</a></li>
        <li><a class="hover:text-parchment" href="/runs/uk-s01">UK S01 replay</a></li>
        <li><a class="hover:text-parchment" href="/runs/india-s01">India S01 deep dive</a></li>
      </ul>
    </div>
    <div>
      <p class="stat-label">Project</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-parchment" href="/how-it-works">How it works</a></li>
        <li><a class="hover:text-parchment" href="/method">Method &amp; limits</a></li>
        <li>
          <a
            class="hover:text-parchment"
            href="https://github.com/kweusuf/traitors-simulation-using-agents"
            rel="noreferrer"
            target="_blank"
          >GitHub repository</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-[var(--border)]">
    <div class="page-shell flex flex-col gap-2 py-5 font-mono text-[10px] uppercase tracking-[0.14em] text-muted md:flex-row md:items-center md:justify-between">
      <span>© {year} Round Table</span>
      <span>{manifest.totals.runs} recorded runs · {formatNumber(manifest.totals.playerGames)} player-games · {formatNumber(manifest.totals.messages)} messages</span>
    </div>
  </div>
</footer>

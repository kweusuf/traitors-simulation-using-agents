---
interface Props {
  eliminations: { id: string; round: number; method: string }[];
  rounds: number;
  survivors: string[];
  traitors?: string[];
  compact?: boolean;
}

const { eliminations, rounds, survivors, traitors = [], compact = false } = Astro.props;
const byRound = new Map<number, { id: string; method: string }[]>();
for (const elimination of eliminations) {
  const list = byRound.get(elimination.round) ?? [];
  list.push(elimination);
  byRound.set(elimination.round, list);
}
const cells = Array.from({ length: rounds }, (_, index) => index + 1);
const traitorSet = new Set(traitors);
---

<div
  class:list={['grid gap-1', compact ? 'grid-flow-col auto-cols-[minmax(8px,1fr)]' : 'grid-flow-col auto-cols-[minmax(14px,1fr)]']}
  role="img"
  aria-label={`Elimination timeline across ${rounds} rounds`}
>
  {cells.map((round) => {
    const exits = byRound.get(round) ?? [];
    const hasTraitor = exits.some((exit) => traitorSet.has(exit.id));
    const hasVote = exits.some((exit) => exit.method === 'vote');
    const hasNight = exits.some((exit) => exit.method === 'night');
    return (
      <span
        class:list={[
          'block rounded-[3px] border',
          exits.length === 0
            ? 'border-[var(--border)] bg-parchment/[0.04]'
            : hasTraitor
              ? 'border-traitor/40 bg-traitor/50'
              : 'border-[var(--color-oxblood)]/40 bg-[var(--color-oxblood)]/40',
          compact ? 'h-2' : 'h-6',
        ]}
        title={`Round ${round}${exits.length ? `: ${exits.map((exit) => `${exit.id} ${exit.method}`).join(', ')}` : ': no elimination'}`}
      >
        {!compact && (
          <span class="flex h-full items-center justify-center gap-0.5">
            {hasVote && <span class="h-1.5 w-1.5 rounded-full bg-parchment/70" />}
            {hasNight && <span class="h-1.5 w-1.5 rotate-45 bg-traitor/90" />}
          </span>
        )}
      </span>
    );
  })}
</div>
<div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[9px] uppercase tracking-[0.12em] text-muted">
  <span><span class="mr-1 inline-block h-1.5 w-1.5 rounded-full bg-parchment/70" />banished</span>
  <span><span class="mr-1 inline-block h-1.5 w-1.5 rotate-45 bg-traitor/90" />murdered</span>
  <span>{survivors.length} survived</span>
</div>

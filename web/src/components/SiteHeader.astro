---
const path = Astro.url.pathname;
const links = [
  { href: '/#stories', label: 'Games' },
  { href: '/runs', label: 'Metrics lab' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/method', label: 'Method' },
];
const isActive = (href: string) => {
  const clean = href.split('#')[0];
  return clean === '/' ? path === '/' : path.startsWith(clean);
};
---

<header class="sticky top-0 z-50 border-b border-[var(--border)] bg-[color-mix(in_srgb,var(--color-ink)_82%,transparent)] backdrop-blur-xl">
  <div class="page-shell flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-3" aria-label="Round Table home">
      <span class="relative grid h-9 w-9 place-items-center rounded-full border border-[var(--border-strong)] bg-black/20">
        <span class="absolute inset-1 rounded-full border border-dashed border-gold/30"></span>
        <span class="font-mono text-[10px] tracking-[0.18em] text-gold">RT</span>
      </span>
      <span class="leading-none">
        <span class="block font-display text-lg tracking-[-0.03em]">Round Table</span>
        <span class="mt-1 block font-mono text-[9px] uppercase tracking-[0.2em] text-muted">Agent simulation archive</span>
      </span>
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-full px-3 py-2 font-mono text-[10px] uppercase tracking-[0.14em] transition',
            isActive(link.href) ? 'bg-parchment/[0.08] text-parchment' : 'text-muted hover:text-parchment',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a
        href="https://github.com/kweusuf/traitors-simulation-using-agents"
        class="btn btn-ghost !min-h-9 !px-3 !py-1.5 text-[11px]"
        rel="noreferrer"
        target="_blank"
      >
        GitHub
      </a>
    </div>
  </div>
  <nav class="page-shell flex gap-2 overflow-x-auto pb-3 md:hidden" aria-label="Main mobile">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'whitespace-nowrap rounded-full border px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.12em]',
          isActive(link.href)
            ? 'border-gold/40 bg-gold/10 text-parchment'
            : 'border-[var(--border)] text-muted',
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

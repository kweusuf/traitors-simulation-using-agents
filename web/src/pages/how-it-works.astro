---
import BaseLayout from '../layouts/BaseLayout.astro';
import BoundaryExplorer from '../components/BoundaryExplorer.tsx';
import { loadSummary } from '../lib/load-run';
import { manifest } from '../lib/data';
import { formatNumber } from '../lib/format';

const ukSummary = await loadSummary('uk-s01-rand-fix_en-fresh');
const steps = [
  {
    id: '01',
    title: 'Config',
    copy: 'One YAML defines the cast, the rules, the optional mechanics, the model, and the concurrency cap. A behavior change is usually a config change.',
  },
  {
    id: '02',
    title: 'Phase engine',
    copy: 'A generic phase loop runs missions, public debate, private chat, the round table, the vote, elimination, and the traitor night in the configured order.',
  },
  {
    id: '03',
    title: 'Agent runtime',
    copy: 'Each player has a persona, goals, memory, beliefs, relationships, and a model handle. The runtime observes, retrieves, prompts, parses, and validates — but never executes an action.',
  },
  {
    id: '04',
    title: 'Prompt + gateway',
    copy: 'A prompt builder composes instructions, role knowledge, memory, and a bounded transcript window. The LLM gateway hides provider details behind one interface.',
  },
  {
    id: '05',
    title: 'Rules + events',
    copy: 'The engine validates actions against legal targets and phase limits, then writes an append-only event log. Replay and resume rebuild state from that log.',
  },
  {
    id: '06',
    title: 'Metrics + replay',
    copy: 'Per-call telemetry and deterministic quality scores describe the run. Projections, timelines, benchmarks, and the score ledger make it comparable.',
  },
];

const metrics = [
  ['hallucination', 'Fabricated eliminations, invented rounds, calling an eliminated player alive. Lower is better.'],
  ['duplication', '1 − distinct texts / messages. 0 means every message is unique; 1 means they are all the same.'],
  ['speech similarity', 'Cosine similarity over each player’s corpus, for content words and character trigrams. Higher means less distinct.'],
  ['secrecy', 'Role claims judged against the role held at that moment. Traitor-only traffic is excluded.'],
  ['reciprocity', 'Two-way private-chat pairs divided by all pairs. A pair count alone cannot tell a conversation from a broadcast.'],
  ['rejected actions', 'Actions the validator refused: illegal targets, role violations, phase limits.'],
];

const evidence = [
  ['Config-driven rules', 'Every mechanic is a flag in the run config; defaults keep older configs playing the same game.'],
  ['Structural secrecy', 'The router enforces channel membership; security tests scan for role leakage.'],
  ['Deterministic testing', 'The fake provider plays complete games without a model. 690 tests pass.'],
  ['Telemetry', 'Per-call tokens, prompt size, retries, and failure classes live beside the run.'],
  ['Experiment gates', 'Paired comparisons with absolute and relative thresholds. Holdout seeds are excluded from promotion.'],
  ['Season replay', 'Pinned casts and traitors, recorded ground truth, and a 12-component alignment score.'],
];
---

<BaseLayout
  title="How it works — Round Table"
  description="How the simulation works: config-driven phases, agent runtime, structural information boundaries, prompts, event logs, quality metrics, experiment gates, and season benchmarks."
>
  <section class="relative overflow-hidden border-b border-[var(--border)]">
    <div class="fog"></div>
    <div class="page-shell relative py-14 md:py-20">
      <span class="eyebrow">How it works</span>
      <h1 class="display mt-4 max-w-4xl text-[clamp(2.6rem,6vw,4.8rem)]">
        The engine never writes prose.<br /><span class="text-gold">It records what the agents do.</span>
      </h1>
      <p class="lede mt-5 max-w-3xl">
        A game is a sequence of validated actions and events. The agents are the
        only source of language; the engine owns state, visibility, rules, and
        the evidence trail.
      </p>
      <div class="mt-7 flex flex-wrap gap-2">
        <span class="badge badge-gold">{formatNumber(manifest.totals.calls)} recorded model calls</span>
        <span class="badge">{formatNumber(manifest.totals.messages)} messages</span>
        <span class="badge">690 deterministic tests</span>
        <span class="badge">fake backend + live providers</span>
      </div>
    </div>
  </section>

  <nav class="page-shell mt-6 flex flex-wrap gap-2" aria-label="On this page">
    {[
      ['#pipeline', 'Pipeline'],
      ['#config', 'Config'],
      ['#boundary', 'Information boundary'],
      ['#evidence', 'Evidence'],
      ['#limits', 'Limits'],
    ].map(([href, label]) => (
      <a class="badge hover:border-gold/50 hover:text-parchment" href={href}>{label}</a>
    ))}
  </nav>

  <section id="pipeline" class="page-shell py-14 md:py-20">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="eyebrow">Pipeline</span>
        <h2 class="display mt-3 text-[clamp(2rem,4vw,3.2rem)]">One run, end to end.</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-muted">
        The same path runs on a live model and on the deterministic fake backend.
        Only the provider changes.
      </p>
    </div>
    <div class="mt-8 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
      {steps.map((step, index) => (
        <article id={`step-${step.id}`} class="card relative p-5">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] tracking-[0.18em] text-gold">{step.id}</span>
            {index < steps.length - 1 && <span class="text-muted" aria-hidden="true">→</span>}
          </div>
          <h3 class="mt-5 font-display text-xl">{step.title}</h3>
          <p class="mt-2 text-[13px] leading-6 text-muted">{step.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="config" class="border-y border-[var(--border)] bg-black/20 py-14 md:py-20">
    <div class="page-shell grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div>
        <span class="eyebrow">Config in, season out</span>
        <h2 class="display mt-3 text-[clamp(2rem,4vw,3rem)]">The game is a file.</h2>
        <p class="lede mt-5">
          The US S03 run below switches on nominations, a restricted revote, a
          sequential traitor council, recruit-or-murder, a quiet first night, and
          an endgame vote. Every one of those is a key in the run's own YAML.
        </p>
        <ul class="mt-5 space-y-2 text-[13px] leading-6 text-muted">
          <li>Cast and persona set</li>
          <li>Phase order and per-phase message limits</li>
          <li>Optional mechanics, all defaulting off</li>
          <li>Provider, model, temperature, and cost bounds</li>
          <li>Seed, experiment id, and artifact identity</li>
        </ul>
      </div>
      <div class="card overflow-hidden">
        <div class="flex items-center justify-between border-b border-[var(--border)] px-4 py-2.5">
          <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted">agent/runs/us-s03-show-conc8/config.yaml</span>
          <span class="badge badge-gold">sanitized excerpt</span>
        </div>
        <pre class="overflow-x-auto p-4 font-mono text-[11px] leading-6 text-parchment/80"><code>{`game:
  name: the-traitors-us-s03
  players: 23
  traitors: 4
  nomination_enabled: true
  revote_enabled: true
  council_deliberation: true
  recruit_choice: true
  quiet_murder_rounds: [1]
  quiet_banishment_rounds: [8]
  endgame_vote: true
  blind_finale_banishments: true
  discussion_budget: 2
  finale_total: 5

phases:
  - mission
  - mission
  - mission
  - public_discussion
  - private_chat
  - round_table
  - voting
  - elimination
  - traitor_night

llm:
  provider: ollama
  model: hauhau-qwen:latest
  temperature: 0.7`}</code></pre>
      </div>
    </div>
  </section>

  <section id="boundary" class="page-shell py-14 md:py-20">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="eyebrow">Information boundary</span>
        <h2 class="display mt-3 text-[clamp(2rem,4vw,3.2rem)]">What did this player actually see?</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-muted">
        Pick a player and a round. The view is built from channel membership, not
        from a prompt instruction.
      </p>
    </div>
    <div class="mt-6">
      {ukSummary ? (
        <BoundaryExplorer summary={ukSummary} client:load />
      ) : (
        <div class="card p-6 text-sm text-muted">Boundary data is unavailable.</div>
      )}
    </div>
    <div class="mt-4 grid gap-3 md:grid-cols-3">
      <div class="card p-4">
        <p class="stat-label">Public</p>
        <p class="mt-2 text-[12px] leading-5 text-muted">Visible to every living player. Hidden roles never appear in public observations.</p>
      </div>
      <div class="card p-4">
        <p class="stat-label">Private</p>
        <p class="mt-2 text-[12px] leading-5 text-muted">Visible only to the sender and recipients. The router enforces the membership.</p>
      </div>
      <div class="card p-4">
        <p class="stat-label">Role-private</p>
        <p class="mt-2 text-[12px] leading-5 text-muted">Visible only to the role's living members at that moment. Recruitment changes the membership.</p>
      </div>
    </div>
  </section>

  <section id="evidence" class="border-y border-[var(--border)] bg-black/20 py-14 md:py-20">
    <div class="page-shell">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <span class="eyebrow">Evidence</span>
          <h2 class="display mt-3 text-[clamp(2rem,4vw,3.2rem)]">Every run is a measurement.</h2>
        </div>
        <p class="max-w-md text-sm leading-6 text-muted">
          Quality is computed from the run's own events and messages. No model is
          consulted to score a run.
        </p>
      </div>

      <div class="mt-8 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        {metrics.map(([title, copy]) => (
          <article class="card p-5">
            <h3 class="font-display text-lg">{title}</h3>
            <p class="mt-2 text-[12px] leading-5 text-muted">{copy}</p>
          </article>
        ))}
      </div>

      <div class="mt-8 grid gap-3 md:grid-cols-2">
        <div class="card p-5">
          <p class="stat-label">Paired experiment gates</p>
          <div class="mt-3 space-y-2 text-[12px] leading-5 text-muted">
            <p><span class="text-parchment">Absolute:</span> hallucination, duplication, speech similarity (content and phrasing), secrecy flags, rejected actions.</p>
            <p><span class="text-parchment">Relative:</span> total tokens, with a 1.25× ceiling. Latency is measured locally but omitted from this public site because it describes one host.</p>
            <p><span class="text-parchment">Holdout:</span> seeds where <code class="font-mono text-gold">seed % 10 &gt;= 7</code> are marked and excluded from promotion decisions.</p>
          </div>
        </div>
        <div class="card p-5">
          <p class="stat-label">Reproducibility</p>
          <div class="mt-3 space-y-2 text-[12px] leading-5 text-muted">
            <p>Each run records its config, seed, provider, model, prompt version, persona version, and game-rules version.</p>
            <p>Replay rebuilds state from the append-only event log; resume continues from the same log.</p>
            <p>The fake backend plays complete games with no model, so the engine is testable without a network or a GPU.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="page-shell py-14 md:py-20">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="eyebrow">Capability map</span>
        <h2 class="display mt-3 text-[clamp(2rem,4vw,3.2rem)]">Claim, then evidence.</h2>
      </div>
      <a class="btn btn-ghost" href="/runs">See it in the lab →</a>
    </div>
    <div class="mt-7 overflow-x-auto">
      <table class="table min-w-[680px]">
        <thead><tr><th>Capability</th><th>Evidence on this site</th></tr></thead>
        <tbody>
          {evidence.map(([capability, proof]) => (
            <tr>
              <td class="whitespace-nowrap text-parchment">{capability}</td>
              <td class="text-[12px] text-muted">{proof}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="limits" class="border-t border-[var(--border)] py-14 md:py-20">
    <div class="page-shell grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <span class="eyebrow">Limits</span>
        <h2 class="display mt-3 text-[clamp(2rem,4vw,3rem)]">What this does not prove.</h2>
        <p class="lede mt-5">
          The framework is measurable; the people are not the experiment. Read the
          method page for provenance, the public-data rules, and the known failure
          modes.
        </p>
        <a class="btn btn-primary mt-6" href="/method">Method &amp; limits</a>
      </div>
      <div class="space-y-3">
        <div class="card p-5">
          <p class="font-display text-lg">Template collapse</p>
          <p class="mt-2 text-[12px] leading-5 text-muted">Long transcripts push models toward the same phrasing. Duplication and speech similarity measure it; they do not solve it.</p>
        </div>
        <div class="card p-5">
          <p class="font-display text-lg">Disposition, not agency</p>
          <p class="mt-2 text-[12px] leading-5 text-muted">Faithful players still lean toward ending the game even with a traitor alive. That is a model disposition and a measured failure mode.</p>
        </div>
        <div class="card p-5">
          <p class="font-display text-lg">Ground truth is recorded, not perfect</p>
          <p class="mt-2 text-[12px] leading-5 text-muted">Some season files are marked unverified. Benchmarks are comparisons against recorded data, not accuracy claims.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

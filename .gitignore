agent/runs/*
!agent/runs/.gitkeep
__pycache__/
*.py[cod]
.venv/
*.db
*.sqlite3
.pytest_cache/
*.egg-info/
dist/
build/
.DS_Store
ollama-model/
*.gguf
# Local, machine-specific configs (remote Ollama endpoint etc.)
*.local.yaml
# Temporary arm files, including a local twin captured by a checkpoint once
*.tmp
*.local.yaml.*
# Local secrets (the tracked template is .env.example)
.env
!.env.example
# Exported chat transcripts, which are session scratch rather than source
cursor_*.md
# Local agent notes. These record machine-specific findings by design, so
# they stay out of a public repo.
AGENTS.md
CLAUDE.md

# Local editor and agent state
.kilo/
.serena/
.delta/
.cursor/
.vscode/

# Website build artifacts
web/node_modules/
web/.astro/
web/.vercel/
web/playwright-report/
web/test-results/

# Site source that a global scripts/ ignore would otherwise hide
!web/scripts/
!web/scripts/**

# The local-detail guard lives at the repo root; the same global ignore
# would otherwise hide it.
!scripts/
!scripts/check_no_local_detail.py
